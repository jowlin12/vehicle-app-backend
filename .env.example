SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Credenciales OAuth exclusivas del backend. Nunca se incluyen en Flutter.
GOOGLE_DRIVE_CLIENT_ID=your-google-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-google-client-secret
GOOGLE_DRIVE_REFRESH_TOKEN=your-google-refresh-token
# Carpeta PADRE que contendrá una carpeta por placa (no colocar aquí el ID de una placa).
GOOGLE_DRIVE_VEHICLE_FOLDER_ID=your-vehicle-root-folder-id
GOOGLE_DRIVE_INVOICE_FOLDER_ID=your-invoice-root-folder-id

# Separar varios orígenes web con comas. Las apps Android/iOS no envían Origin.
ALLOWED_ORIGINS=https://your-flutter-web.example.com

# --- Dictado por voz -------------------------------------------------------
# Extracción de campos a partir de lo que dice el mecánico. Si no hay ninguna
# llave, el endpoint responde 503 y la app usa su parser local (entiende
# kilometraje, dinero, teléfono y año, pero no habla libre).
#
# Groq es gratis: la llave se saca en https://console.groq.com/keys
GROQ_API_KEY=gsk_tu-llave-gratis-de-groq
# Respaldo opcional de pago. Si está puesta, se usa solo cuando Groq falla o se
# agota el plan gratis.
# ANTHROPIC_API_KEY=sk-ant-tu-llave
# Fuerza un proveedor concreto ("groq" o "anthropic"). Útil para comparar cuál
# acierta más con los dictados reales del taller.
# VOZ_PROVEEDOR=groq
